# PulseBoost — variables d'environnement du serveur (serveur licence + effecteur Discord)
# Copie ce fichier en .env (ou colle ces valeurs dans le dashboard de ton hebergeur de bot).
# NE JAMAIS committer le .env rempli.

# --- Discord OAuth (application Discord) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Effecteur Discord (le "bot" : DM, role Pro, logs — REST only, pas de gateway) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_PRO_ROLE_ID=
DISCORD_LOG_CHANNEL_ID=

# --- Serveur ---
# URL publique HTTPS de CE serveur (celle que l'hebergeur t'attribue, ou ton domaine).
PUBLIC_URL=https://ton-app.exemple-host.com
PORT=8787
# Dossier de stockage persistant pour la base SQLite (IMPORTANT sur un hebergeur
# de bots ou le filesystem est ephemere : pointe vers un disque persistant).
DATA_DIR=./data

# HMAC des sessions — 32+ octets aleatoires : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Cle privee Ed25519 (hex) generee par `npm run keygen`. Copier la cle PUBLIQUE dans le client Rust.
LICENSE_PRIVATE_KEY=

# IDs Discord autorises sur le panel admin (separes par des virgules).
ADMIN_DISCORD_IDS=

# --- IA : Google Gemini (analyse Pro, 100% serveur) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
